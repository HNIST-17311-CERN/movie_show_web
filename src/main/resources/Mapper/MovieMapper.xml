<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.Mapper.MovieMapper">

    <resultMap id="MovieMap" type="org.example.Entity.Movie_details">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="cover" column="cover"/>
        <result property="director" column="director"/>
        <result property="actors" column="actors"/>
        <result property="type" column="type"/>
        <result property="region" column="region"/>
        <result property="language" column="language"/>
        <result property="releaseDate" column="release_date"/>
        <result property="duration" column="duration"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <resultMap id="MovieCascadeScoreMap" type="org.example.Entity.MovieCascadeDetails" extends="MovieMap">
        <association property="score" javaType="org.example.Entity.Movie_Score">
            <id property="id" column="score_id"/>
            <result property="movieId" column="score_movie_id"/>
            <result property="source" column="score_source"/>
            <result property="score" column="score_value"/>
            <result property="count" column="score_count"/>
        </association>
    </resultMap>

    <resultMap id="MovieCascadeResourcesMap" type="org.example.Entity.MovieCascadeDetails" extends="MovieMap">
        <collection property="resources" ofType="org.example.Entity.Movie_Resource">
            <id property="id" column="resource_id"/>
            <result property="movieId" column="resource_movie_id"/>
            <result property="name" column="resource_name"/>
            <result property="quality" column="resource_quality"/>
            <result property="size" column="resource_size"/>
            <result property="type" column="resource_type"/>
            <result property="url" column="resource_url"/>
            <result property="createTime" column="resource_create_time"/>
            <result property="subtitle" column="resource_subtitle"/>
        </collection>
    </resultMap>

    <select id="findlast12" resultMap="MovieMap">
        SELECT *
        FROM movie
        WHERE id IN (50, 67, 52, 4555, 96, 104, 1177, 23, 59, 27, 64, 29)
        ORDER BY FIELD(id, 50, 67, 52, 4555, 96, 104, 1177, 23, 59, 27, 64, 29)
    </select>

    <select id="findMovieWithScoreById" resultMap="MovieCascadeScoreMap">
        SELECT
            m.*,
            s.id AS score_id,
            s.movie_id AS score_movie_id,
            s.source AS score_source,
            s.score AS score_value,
            s.count AS score_count
        FROM movie m
        LEFT JOIN movie_score s ON m.id = s.movie_id
        WHERE m.id = #{id}
    </select>

    <select id="findMovieWithResourcesById" resultMap="MovieCascadeResourcesMap">
        SELECT
            m.*,
            r.id AS resource_id,
            r.movie_id AS resource_movie_id,
            r.name AS resource_name,
            r.quality AS resource_quality,
            r.size AS resource_size,
            r.type AS resource_type,
            r.url AS resource_url,
            r.create_time AS resource_create_time,
            r.subtitle AS resource_subtitle
        FROM movie m
        LEFT JOIN movie_resource r ON m.id = r.movie_id
        WHERE m.id = #{id}
    </select>

</mapper>
